:{$PORT} {
	root * dist
	encode gzip zstd

	# Hashed build assets — safe to cache for a long time because the filename
	# changes on every rebuild. If the file is missing, return a real 404 instead
	# of falling back to index.html (which would be served as text/html and break
	# the browser's <script> tag silently).
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: SPA fallback to index.html, and never cache the shell so a
	# new deploy is picked up immediately.
	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
		file_server
	}
}
